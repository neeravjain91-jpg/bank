# Application Environment Configuration
APP_NAME="Bank Statement Table Extraction API"
APP_ENV="production"
APP_PORT=8000
APP_HOST="0.0.0.0"
LOG_LEVEL="INFO"

# Security & Access Control
# Set API_KEY to require 'X-API-Key' authentication header on /extract and /categorize.
# Leave empty or unset to run in open/demo development mode.
API_KEY=""
ALLOWED_ORIGINS="*"

# ML & NLP Configuration
USE_ML_LINE_CLASSIFIER=true
USE_HF_TRANSFORMERS=false
HF_MODEL_NAME="typeform/distilbert-base-uncased-mnli"
MODEL_CACHE_DIR="./data/models_cache"

# Bankstatemently Benchmark Evaluation API (optional)
BANKSTATEMENTLY_API_KEY=""
BANKSTATEMENTLY_API_URL="https://api.bankstatemently.com/v1/benchmark/evaluate"

# Storage & Upload Limits (20 MB default)
MAX_UPLOAD_SIZE_BYTES=20971520
